---
const { title, beers = [] } = Astro.props;
const collapseId = `watch-${title.toLowerCase().replaceAll(' ', '-')}`;
---
<details class="card group" data-collapse-id={collapseId}>
  <summary class="mb-2 flex cursor-pointer list-none items-center justify-between gap-3">
    <h2 class="text-lg font-semibold">{title}</h2>
    <span class="text-sm font-medium text-pine group-open:hidden">Expand</span>
    <span class="hidden text-sm font-medium text-pine group-open:inline">Collapse</span>
  </summary>
  {beers.length === 0 ? (
    <p class="text-sm text-ink/70">No matching beers.</p>
  ) : (
    <ul class="grid gap-2 text-sm">
      {beers.map((beer) => (
        <li class="rounded border border-ink/10 bg-white px-3 py-2">
          <span class="font-medium">{beer.name}</span>
          <span class="text-ink/70"> · {beer.breweryName} · {beer.style || 'Unknown style'}</span>
        </li>
      ))}
    </ul>
  )}
</details>
