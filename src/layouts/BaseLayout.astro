---
import '../styles.css';
const { title = 'Pittsburgh Taplist Tracker' } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen bg-gradient-to-b from-cream via-white to-cream">
      <main class="mx-auto w-full max-w-6xl px-4 py-8">
        <slot />
      </main>
    </div>
    <script>
      const storagePrefix = 'pgh-tap-list:collapse:';
      const persistDetails = (details) => {
        const collapseId = details.getAttribute('data-collapse-id');
        if (!collapseId) {
          return;
        }

        localStorage.setItem(`${storagePrefix}${collapseId}`, details.open ? 'open' : 'closed');
      };

      document.querySelectorAll('details[data-collapse-id]').forEach((details) => {
        const collapseId = details.getAttribute('data-collapse-id');
        if (!collapseId) {
          return;
        }

        const storageKey = `${storagePrefix}${collapseId}`;
        const storedValue = localStorage.getItem(storageKey);

        if (storedValue === 'open') {
          details.open = true;
        }

        if (storedValue === 'closed') {
          details.open = false;
        }

        details.addEventListener('toggle', () => {
          persistDetails(details);
        });
      });

      window.addEventListener('beforeunload', () => {
        document.querySelectorAll('details[data-collapse-id]').forEach((details) => {
          persistDetails(details);
        });
      });
    </script>
  </body>
</html>
