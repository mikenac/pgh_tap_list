---
import '../styles.css';
const { title = 'Pittsburgh Taplist Tracker' } = Astro.props;
const basePath = import.meta.env.BASE_URL.replace(/\/$/, '');
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const dashboardPath = `${basePath}/dashboard`;
const isDashboard = pathname === dashboardPath;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
  </head>
  <body>
    <div class="min-h-screen bg-gradient-to-b from-cream via-white to-cream">
      <main class="mx-auto w-full max-w-6xl px-4 py-8">
        <nav class="mb-6 flex gap-2 text-sm font-medium" aria-label="Primary">
          <a
            class={`rounded border px-3 py-2 ${isDashboard ? 'border-ink/20 bg-white text-ink hover:bg-ink hover:text-white' : 'border-pine bg-pine text-white'}`}
            href={`${basePath}/`}
          >
            Taplists
          </a>
          <a
            class={`rounded border px-3 py-2 ${isDashboard ? 'border-pine bg-pine text-white' : 'border-ink/20 bg-white text-ink hover:bg-ink hover:text-white'}`}
            href={dashboardPath}
          >
            Dashboard
          </a>
        </nav>
        <slot />
      </main>
    </div>
    <script>
      const storagePrefix = 'pgh-tap-list:collapse:';
      const persistDetails = (details) => {
        const collapseId = details.getAttribute('data-collapse-id');
        if (!collapseId) {
          return;
        }

        localStorage.setItem(`${storagePrefix}${collapseId}`, details.open ? 'open' : 'closed');
      };

      document.querySelectorAll('details[data-collapse-id]').forEach((details) => {
        const collapseId = details.getAttribute('data-collapse-id');
        if (!collapseId) {
          return;
        }

        const storageKey = `${storagePrefix}${collapseId}`;
        const storedValue = localStorage.getItem(storageKey);

        if (storedValue === 'open') {
          details.open = true;
        }

        if (storedValue === 'closed') {
          details.open = false;
        }

        details.addEventListener('toggle', () => {
          persistDetails(details);
        });
      });

      const localTimeFormatter = new Intl.DateTimeFormat(undefined, {
        year: 'numeric',
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
        timeZoneName: 'short',
      });

      document.querySelectorAll('time[data-local-time]').forEach((timeElement) => {
        const rawTimestamp = timeElement.getAttribute('datetime');
        if (!rawTimestamp) {
          return;
        }

        const timestamp = new Date(rawTimestamp);
        if (Number.isNaN(timestamp.getTime())) {
          return;
        }

        timeElement.textContent = localTimeFormatter.format(timestamp);
        timeElement.setAttribute('title', rawTimestamp);
      });

      window.addEventListener('beforeunload', () => {
        document.querySelectorAll('details[data-collapse-id]').forEach((details) => {
          persistDetails(details);
        });
      });
    </script>
  </body>
</html>
